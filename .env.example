# Copy to .env.local and fill in the values.

# Base URL of the Trelly API.
VITE_API_URL=https://trelly.it-incubator.app/api

# Access token from https://apihub.it-incubator.io (expires after up to 3 days).
VITE_AUTH_TOKEN=

# API key from https://apihub.it-incubator.io, sent with every API request.
VITE_API_KEY=
